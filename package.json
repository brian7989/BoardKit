{
  "name": "boardkit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck",
    "check:structure": "node scripts/checkFileExports.js",
    "check:comments": "node scripts/checkComments.js",
    "check:esm": "node scripts/smokeImport.mjs",
    "check:publint": "publint packages/core && publint packages/react",
    "check:types": "attw --pack packages/core --profile esm-only && attw --pack packages/react --profile esm-only --exclude-entrypoints ./styles.css",
    "size": "size-limit",
    "bench": "pnpm --filter boardkit-core build && node scripts/benchSolver.mjs",
    "e2e": "pnpm --filter playground e2e",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@size-limit/preset-small-lib": "^14.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.16.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.31.0",
    "fast-check": "^3.23.1",
    "knip": "^6.37.0",
    "publint": "^0.3.24",
    "size-limit": "^14.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
